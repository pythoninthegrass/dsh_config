# $DSH_HOME/.credentials.yaml — dsh-credentials-local's managed store. Symlinked here from
# ~/.dsh/.credentials.yaml (see settings.yaml for the same pattern). Real file is gitignored;
# this .example documents the schema and is the one committed.
#
# Resolution precedence for an apiKeyEnv ref (highest wins): inherited process env > this file
# > <invocation cwd>/.env > $DSH_HOME/.env. Unlike the .env layers, this file is read regardless
# of what environment the dsh process was launched with — the fix for GUI-launched clients (e.g.
# DeepSeek Harness Desktop on macOS) that don't inherit an interactive shell's exported vars and
# would otherwise re-prompt "Add an API key to get started" on every launch. See
# docs/credentials-store.md.
version: 1

refs:
  LOCAL_API_KEY: "your-key-here"
  # TINYFISH_API_KEY: "your-key-here"

# records:
#   llm-pi-ai/some-oauth-provider:
#     kind: grant
#     payload:
#       type: oauth
#       access: ...
