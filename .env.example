# local OpenAI-compatible endpoint (vLLM/llama-swap on mf, omlx elsewhere) — apiKeyEnv in
# settings.yaml is schema boilerplate neither backend checks, but dsh may warn on a missing
# env var. Value is arbitrary; keep it consistent with $DSH_HOME/.credentials.yaml.
LOCAL_API_KEY="vllm"

# MCP servers currently in .mcp.json (backlog, context7, serena) need no secrets today.
# Add their vars here as they're needed, e.g.:
# CONTEXT7_API_KEY="your-key-here"

# tinyfish MCP server (streamable-http, see .mcp.json / profiles/*/cordis.patch.yml)
TINYFISH_API_KEY="your-key-here"
