# lemonade (local OpenAI-compatible endpoint) — apiKeyEnv in settings.yaml is schema
# boilerplate lemonade doesn't check, but dsh may warn on a missing env var.
LOCAL_API_KEY="lemonade"

# MCP servers currently in .mcp.json (backlog, context7, serena) need no secrets today.
# Add their vars here as they're needed, e.g.:
# CONTEXT7_API_KEY="your-key-here"
